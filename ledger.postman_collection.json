{
  "info": { "name": "Ledger API", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "accountId", "value": "" },
    { "key": "accountId2", "value": "" }
  ],
  "item": [
    { "name": "1. Create account A",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.collectionVariables.set('accountId', pm.response.json().id);"] } }],
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"name\": \"Alice\"}" }, "url": "{{baseUrl}}/accounts" } },
    { "name": "2. Create account B",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.collectionVariables.set('accountId2', pm.response.json().id);"] } }],
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"name\": \"Bob\"}" }, "url": "{{baseUrl}}/accounts" } },
    { "name": "3. Credit 100",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"type\":\"credit\",\"amount\":100,\"description\":\"Deposit\",\"reference_id\":\"ref-1\"}" },
        "url": "{{baseUrl}}/accounts/{{accountId}}/transactions" } },
    { "name": "4. Credit 50",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"type\":\"credit\",\"amount\":50,\"description\":\"Deposit\",\"reference_id\":\"ref-2\"}" },
        "url": "{{baseUrl}}/accounts/{{accountId}}/transactions" } },
    { "name": "5. Debit 30",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"type\":\"debit\",\"amount\":30,\"description\":\"Withdraw\",\"reference_id\":\"ref-3\"}" },
        "url": "{{baseUrl}}/accounts/{{accountId}}/transactions" } },
    { "name": "6. Debit 20",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"type\":\"debit\",\"amount\":20,\"description\":\"Withdraw\",\"reference_id\":\"ref-4\"}" },
        "url": "{{baseUrl}}/accounts/{{accountId}}/transactions" } },
    { "name": "7. Get balance (expect 100.00)",
      "request": { "method": "GET", "url": "{{baseUrl}}/accounts/{{accountId}}/balance" } },
    { "name": "8. Debit 1000 (expect 422)",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"type\":\"debit\",\"amount\":1000,\"reference_id\":\"ref-big\"}" },
        "url": "{{baseUrl}}/accounts/{{accountId}}/transactions" } },
    { "name": "9. Duplicate ref-1 (expect 409)",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"type\":\"credit\",\"amount\":100,\"reference_id\":\"ref-1\"}" },
        "url": "{{baseUrl}}/accounts/{{accountId}}/transactions" } },
    { "name": "10. Same ref-1 on account B (expect 201)",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"type\":\"credit\",\"amount\":50,\"reference_id\":\"ref-1\"}" },
        "url": "{{baseUrl}}/accounts/{{accountId2}}/transactions" } },
    { "name": "11. Negative amount (expect 400)",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"type\":\"credit\",\"amount\":-5,\"reference_id\":\"ref-neg\"}" },
        "url": "{{baseUrl}}/accounts/{{accountId}}/transactions" } },
    { "name": "12. Bad type (expect 400)",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"type\":\"refund\",\"amount\":5,\"reference_id\":\"ref-bad\"}" },
        "url": "{{baseUrl}}/accounts/{{accountId}}/transactions" } },
    { "name": "13. History (all, page 1, limit 2)",
      "request": { "method": "GET", "url": "{{baseUrl}}/accounts/{{accountId}}/transactions?page=1&limit=2" } },
    { "name": "14. History (debit only)",
      "request": { "method": "GET", "url": "{{baseUrl}}/accounts/{{accountId}}/transactions?type=debit" } },
    { "name": "15. Invalid pagination (expect 400)",
      "request": { "method": "GET", "url": "{{baseUrl}}/accounts/{{accountId}}/transactions?page=0&limit=abc" } },
    { "name": "16. Unknown account (expect 404)",
      "request": { "method": "GET", "url": "{{baseUrl}}/accounts/00000000-0000-0000-0000-000000000000/balance" } },
    { "name": "17. Invalid account id (expect 400)",
      "request": { "method": "GET", "url": "{{baseUrl}}/accounts/abc/balance" } },
    { "name": "18. Transfer 30 A to B (bonus)",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"from_account_id\":\"{{accountId}}\",\"to_account_id\":\"{{accountId2}}\",\"amount\":30}" },
        "url": "{{baseUrl}}/transfers" } },
    { "name": "19. Try to delete a transaction (expect 405)",
      "request": { "method": "DELETE", "url": "{{baseUrl}}/accounts/{{accountId}}/transactions/anything" } }
  ]
}
